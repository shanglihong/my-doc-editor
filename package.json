{
  "name": "my-doc-editor",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/my-doc-editor.umd.cjs",
  "module": "./dist/my-doc-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/my-doc-editor.js",
      "require": "./dist/my-doc-editor.umd.cjs"
    },
    "./dist/style.css": "./dist/my-doc-editor.css",
    "./dist/my-doc-editor.css": "./dist/my-doc-editor.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepare": "npm run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "setup:drawio": "node scripts/setup-drawio.mjs"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.30.0",
    "@tiptap/extension-color": "^3.30.0",
    "@tiptap/extension-highlight": "^3.30.0",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-table-cell": "^3.30.0",
    "@tiptap/extension-table-header": "^3.30.0",
    "@tiptap/extension-table-row": "^3.30.0",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.0",
    "@tiptap/extension-text-style": "^3.30.0",
    "@tiptap/extension-underline": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@tiptap/suggestion": "^3.30.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^27.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
